NODE_ENV=development
PORT=3000
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
ADMIN_USERNAME=waifaier

# Caminho do SQLite. Em Render com Persistent Disk, use:
# SQLITE_PATH=/var/data/chat.db
SQLITE_PATH=

# Diretório persistente dos uploads. Em Render com Persistent Disk, use:
# UPLOAD_DIR=/var/data/uploads
UPLOAD_DIR=

# URL do checkout real para o botão "Pagar R$ 20,00" do WFNA.
WFNA_PAYMENT_URL=

# WebRTC TURN (recomendado para chamadas entre redes diferentes)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Código para ativar o primeiro administrador pela UI (Configurações >
# Avançado > "Ativar administrador"), quando não há acesso a shell para
# rodar `npm run admin:setup`. Só funciona enquanto NÃO existir nenhum
# administrador; depois do primeiro, fica desativado sozinho. Deixe em
# branco para desativar esse caminho por completo. Nunca é enviado ao
# client-side — fica só aqui, no ambiente do servidor.
ADMIN_CLAIM_CODE=
