<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- OBS: o serviço de primeiro plano da chamada (câmera/áudio/tela
             continuando mesmo com o app em segundo plano) entra na etapa do
             compartilhamento de tela nativo, junto com o resto do código de
             MediaProjection — nada aqui na primeira leva referencia classe
             que ainda não existe, pra não arriscar quebrar o build. -->

        <!-- Notificação de "ligação chegando" via push (FCM) — acorda o
             app mesmo fechado/tela bloqueada. Só recebe algo de verdade
             depois que google-services.json for adicionado ao projeto. -->
        <service
            android:name=".push.WifiCordFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".push.CallRejectReceiver"
            android:exported="false" />

        <!-- Assim que o celular liga, reconfirma o token de notificação
             push no servidor — sem isso, se o token tivesse mudado com o
             aparelho desligado, as notificações só voltariam a funcionar
             na próxima vez que alguém abrisse o app manualmente. -->
        <receiver
            android:name=".push.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Roda o BootReceiver quando o celular liga (ver abaixo) — o sistema
         já isenta esse aviso específico dos limites de execução em 2º
         plano do Android 8+, então funciona mesmo sem o app ter sido
         aberto nenhuma vez desde o boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Chamada de câmera/áudio (getUserMedia dentro da WebView) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Manter a tela ligada durante uma chamada -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- FOREGROUND_SERVICE_CAMERA/MICROPHONE/MEDIA_PROJECTION e
         SYSTEM_ALERT_WINDOW entram junto com o serviço de primeiro plano na
         etapa do compartilhamento de tela nativo. -->

    <!-- Notificação de "atualização disponível" (obrigatória pedir em
         runtime a partir do Android 13/API 33) — a mesma permissão cobre
         a notificação de ligação recebida. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Baixar e instalar a atualização sem precisar desinstalar o app -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Faz a notificação de ligação recebida aparecer em tela cheia mesmo
         com o celular bloqueado, igual uma tela de chamada de verdade. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
</manifest>
