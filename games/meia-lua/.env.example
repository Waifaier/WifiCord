# Copie para ".env" e ajuste. Nenhuma chave de API é necessária.

# Porta HTTP do servidor
PORT=3000

# Caminho do arquivo SQLite (criado automaticamente)
DB_PATH=./data/game.sqlite

# Máximo de jogadores por sala (1-8)
MAX_PLAYERS_PER_ROOM=4

# Duração de uma noite em segundos reais (00:00 → 06:00)
NIGHT_SECONDS=360

# Quantas salas simultâneas o servidor aceita
MAX_ROOMS=50

# Servidores ICE para voz WebRTC (JSON). STUN público gratuito por padrão.
# Se quiser um TURN próprio (ex.: coturn gratuito na sua máquina), adicione aqui.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Origem permitida para o Socket.IO (deixe * para desenvolvimento)
CORS_ORIGIN=*

# Modo de depuração: 1 = logs extras
DEBUG=0
